{
  "info": {
    "name": "JSONPlaceholder API Tests",
    "description": "Тесты для https://jsonplaceholder.typicode.com: GET, POST, PUT, PATCH, DELETE и негативный сценарий.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET - Get all posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type содержит application/json\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Время ответа меньше 2000 мс\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"Ответ — массив из 100 постов\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"array\");",
              "    pm.expect(json).to.have.lengthOf(100);",
              "});",
              "",
              "pm.test(\"У поста есть поля userId, id, title, body\", function () {",
              "    const post = pm.response.json()[0];",
              "    pm.expect(post).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      }
    },
    {
      "name": "GET - Get post by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type содержит application/json\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Время ответа меньше 2000 мс\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"id поста равен 1\", function () {",
              "    pm.expect(pm.response.json().id).to.eql(1);",
              "});",
              "",
              "pm.test(\"Типы полей корректны\", function () {",
              "    const post = pm.response.json();",
              "    pm.expect(post.userId).to.be.a(\"number\");",
              "    pm.expect(post.title).to.be.a(\"string\");",
              "    pm.expect(post.body).to.be.a(\"string\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "POST - Create post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Content-Type содержит application/json\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Время ответа меньше 2000 мс\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"Ответ содержит id нового поста\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});",
              "",
              "pm.test(\"Данные в ответе совпадают с отправленными\", function () {",
              "    const sent = JSON.parse(pm.request.body.raw);",
              "    const json = pm.response.json();",
              "    pm.expect(json.title).to.eql(sent.title);",
              "    pm.expect(json.body).to.eql(sent.body);",
              "    pm.expect(json.userId).to.eql(sent.userId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=UTF-8"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"test title\",\n  \"body\": \"test body\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PUT - Update post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Время ответа меньше 2000 мс\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"id поста остался 1\", function () {",
              "    pm.expect(pm.response.json().id).to.eql(1);",
              "});",
              "",
              "pm.test(\"Данные в ответе совпадают с отправленными\", function () {",
              "    const sent = JSON.parse(pm.request.body.raw);",
              "    const json = pm.response.json();",
              "    pm.expect(json.title).to.eql(sent.title);",
              "    pm.expect(json.body).to.eql(sent.body);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=UTF-8"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"updated title\",\n  \"body\": \"updated body\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PATCH - Partially update post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Время ответа меньше 2000 мс\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"Поле title обновилось\", function () {",
              "    const sent = JSON.parse(pm.request.body.raw);",
              "    pm.expect(pm.response.json().title).to.eql(sent.title);",
              "});",
              "",
              "pm.test(\"Остальные поля поста сохранились\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"body\");",
              "    pm.expect(json).to.have.property(\"userId\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=UTF-8"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"patched title\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },

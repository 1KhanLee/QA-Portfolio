              "});",
              "",
              "pm.test(\"Время ответа меньше 2000 мс\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"Тело ответа — пустой объект\", function () {",
              "    pm.expect(pm.response.json()).to.eql({});",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
